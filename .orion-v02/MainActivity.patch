     private void speak(String text, String id) {
         responseText.setText(text);
+        String apiKey = prefs.getString("openai_key", "").trim();
+        boolean neuralVoice = prefs.getBoolean("openai_voice_enabled", true);
+        if (neuralVoice && !apiKey.isEmpty()) {
+            speakWithOpenAi(text, id, apiKey);
+            return;
+        }
+        speakLocal(text, id);
+    }
+
+    private void speakWithOpenAi(String text, String id, String apiKey) {
+        releaseVoicePlayer();
+        setState(OrionView.State.THINKING, "PREPARANDO VOZ");
+        String voice = prefs.getString("openai_voice", "onyx").trim();
+        networkExecutor.execute(() -> {
+            try {
+                File generated = OpenAiSpeechClient.synthesize(getCacheDir(), apiKey, voice, text);
+                mainHandler.post(() -> playGeneratedVoice(generated, id));
+            } catch (Exception e) {
+                mainHandler.post(() -> {
+                    Toast.makeText(this, "Voz neural indisponível. Usando voz local.", Toast.LENGTH_SHORT).show();
+                    speakLocal(text, id);
+                });
+            }
+        });
+    }
+
+    private void playGeneratedVoice(File file, String id) {
+        releaseVoicePlayer();
+        voiceFile = file;
+        try {
+            voicePlayer = new MediaPlayer();
+            voicePlayer.setDataSource(file.getAbsolutePath());
+            voicePlayer.setOnPreparedListener(mp -> {
+                setState(OrionView.State.SPEAKING, "FALANDO");
+                mp.start();
+            });
+            voicePlayer.setOnCompletionListener(mp -> {
+                releaseVoicePlayer();
+                onSpeechDone(id);
+            });
+            voicePlayer.setOnErrorListener((mp, what, extra) -> {
+                releaseVoicePlayer();
+                speakLocal(responseText.getText().toString(), id);
+                return true;
+            });
+            voicePlayer.prepareAsync();
+        } catch (Exception e) {
+            releaseVoicePlayer();
+            speakLocal(responseText.getText().toString(), id);
+        }
+    }
+
